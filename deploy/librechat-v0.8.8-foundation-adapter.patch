diff --git a/packages/api/src/endpoints/custom/foundationContext.ts b/packages/api/src/endpoints/custom/foundationContext.ts
new file mode 100644
index 0000000..653d942
--- /dev/null
+++ b/packages/api/src/endpoints/custom/foundationContext.ts
@@ -0,0 +1,47 @@
+import type { FoundationSigningContext } from '~/types';
+
+const FOUNDATION_MODES = {
+  'foundation-auto': ['CHAT', 'daily-default'],
+  'foundation-search': ['SEARCH', ''],
+  'foundation-code': ['CODE', 'repo-default'],
+  'foundation-data': ['DATA', 'json-summary'],
+  'foundation-files': ['FILES', 'files-default'],
+  'foundation-vision': ['VISION', ''],
+} as const;
+
+export function createFoundationAuxiliarySigningContext(
+  endpoint: string,
+  owner?: string,
+): FoundationSigningContext | undefined {
+  if (endpoint !== 'Foundation' || !owner) {
+    return undefined;
+  }
+  return {
+    owner,
+    attachmentIds: [],
+    capability: 'CHAT',
+    scope: '',
+    longRunning: false,
+    ready: true,
+  };
+}
+
+export function createFoundationSigningContext(
+  endpoint: string,
+  model: string,
+  owner?: string,
+): FoundationSigningContext | undefined {
+  if (endpoint !== 'Foundation' || !owner) {
+    return undefined;
+  }
+  const mode =
+    FOUNDATION_MODES[model as keyof typeof FOUNDATION_MODES] ?? FOUNDATION_MODES['foundation-auto'];
+  return {
+    owner,
+    attachmentIds: [],
+    capability: mode[0],
+    scope: mode[1],
+    longRunning: false,
+    ready: false,
+  };
+}
diff --git a/packages/api/src/endpoints/custom/foundationSigning.spec.ts b/packages/api/src/endpoints/custom/foundationSigning.spec.ts
new file mode 100644
index 0000000..7dd2d01
--- /dev/null
+++ b/packages/api/src/endpoints/custom/foundationSigning.spec.ts
@@ -0,0 +1,80 @@
+import { createHash, createHmac } from 'node:crypto';
+import {
+  createFoundationAuxiliarySigningContext,
+  createFoundationSigningContext,
+} from './foundationContext';
+import { createFoundationFinalRequestTransform } from './foundationSigning';
+
+describe('Foundation final request signing', () => {
+  it('signs the exact final body and delegates to the selected transport', async () => {
+    const context = createFoundationSigningContext('Foundation', 'foundation-auto', 'user-a')!;
+    context.attachmentIds = ['file-a'];
+    context.ready = true;
+    const next = jest.fn(async (_url, init?: RequestInit) => {
+      const headers = new Headers(init?.headers);
+      return new Response(JSON.stringify(Object.fromEntries(headers.entries())));
+    });
+    const body = JSON.stringify({ model: 'foundation-auto', messages: [{ role: 'user', content: 'hi' }] });
+    const transform = createFoundationFinalRequestTransform(context, 'secret');
+    const response = await transform('http://foundation/v1/chat/completions', { body }, next);
+    const headers = JSON.parse(await response.text()) as Record<string, string>;
+
+    expect(next).toHaveBeenCalledTimes(1);
+    expect(headers['x-foundation-owner']).toBe('user-a');
+    expect(headers['x-foundation-attachments']).toBe('["file-a"]');
+    expect(headers['x-foundation-capability']).toBe('CHAT');
+    expect(headers['x-foundation-scope']).toBe('daily-default');
+    const digest = createHash('sha256').update(Buffer.from(body)).digest('hex');
+    const message = ['v2', 'user-a', '["file-a"]', 'CHAT', 'daily-default', '0',
+      headers['x-foundation-attachment-timestamp'], digest].join('\n');
+    expect(headers['x-foundation-attachment-signature']).toBe(
+      createHmac('sha256', 'secret').update(message).digest('hex'),
+    );
+  });
+
+  it('fails closed before standard attachment authority is finalized', async () => {
+    const context = createFoundationSigningContext('Foundation', 'foundation-auto', 'user-a')!;
+    const next = jest.fn();
+    await expect(
+      createFoundationFinalRequestTransform(context, 'secret')('http://foundation', { body: '{}' }, next),
+    ).rejects.toThrow('not ready');
+    expect(next).not.toHaveBeenCalled();
+  });
+
+  it('keeps concurrent request authority isolated', async () => {
+    const a = createFoundationSigningContext('Foundation', 'foundation-files', 'user-a')!;
+    const b = createFoundationSigningContext('Foundation', 'foundation-vision', 'user-b')!;
+    a.attachmentIds = ['a1'];
+    b.attachmentIds = ['b1'];
+    a.ready = true;
+    b.ready = true;
+    const capture = async (_url: string | URL | Request, init?: RequestInit) =>
+      new Response(JSON.stringify(Object.fromEntries(new Headers(init?.headers).entries())));
+    const [ra, rb] = await Promise.all([
+      createFoundationFinalRequestTransform(a, 'secret')('http://foundation', { body: '{"a":1}' }, capture),
+      createFoundationFinalRequestTransform(b, 'secret')('http://foundation', { body: '{"b":1}' }, capture),
+    ]);
+    const ha = JSON.parse(await ra.text()) as Record<string, string>;
+    const hb = JSON.parse(await rb.text()) as Record<string, string>;
+    expect([ha['x-foundation-owner'], ha['x-foundation-attachments'], ha['x-foundation-capability']])
+      .toEqual(['user-a', '["a1"]', 'FILES']);
+    expect([hb['x-foundation-owner'], hb['x-foundation-attachments'], hb['x-foundation-capability']])
+      .toEqual(['user-b', '["b1"]', 'VISION']);
+  });
+
+  it('fails auxiliary Foundation calls down to CHAT with no scope or attachments', () => {
+    const context = createFoundationAuxiliarySigningContext('Foundation', 'user-a')!;
+    expect(context).toEqual({
+      owner: 'user-a',
+      attachmentIds: [],
+      capability: 'CHAT',
+      scope: '',
+      longRunning: false,
+      ready: true,
+    });
+  });
+
+  it('does not create signing authority for non-Foundation endpoints', () => {
+    expect(createFoundationSigningContext('openAI', 'foundation-auto', 'user-a')).toBeUndefined();
+  });
+});
diff --git a/packages/api/src/endpoints/custom/foundationSigning.ts b/packages/api/src/endpoints/custom/foundationSigning.ts
new file mode 100644
index 0000000..e0c5892
--- /dev/null
+++ b/packages/api/src/endpoints/custom/foundationSigning.ts
@@ -0,0 +1,68 @@
+import { createHash, createHmac } from 'node:crypto';
+import type { FoundationSigningContext } from '~/types';
+
+type NextFetch = (
+  url: string | URL | Request,
+  init?: RequestInit,
+) => Promise<Response>;
+
+function serializedBody(body: BodyInit | null | undefined): Buffer {
+  if (typeof body === 'string') {
+    return Buffer.from(body);
+  }
+  if (body instanceof Uint8Array) {
+    return Buffer.from(body);
+  }
+  throw new Error('Foundation signing requires a final serialized request body');
+}
+
+export function createFoundationFinalRequestTransform(
+  context: FoundationSigningContext,
+  secret: string,
+) {
+  return async (
+    url: string | URL | Request,
+    init: RequestInit | undefined,
+    next: NextFetch,
+  ): Promise<Response> => {
+    if (!context.ready || !context.owner || !secret) {
+      throw new Error('Foundation signing context is not ready');
+    }
+
+    const body = serializedBody(init?.body);
+    const timestamp = Math.floor(Date.now() / 1000).toString();
+    const attachmentIds = context.attachmentIds.filter((id) => id.length > 0);
+    const serializedIds = JSON.stringify(attachmentIds);
+    const digest = createHash('sha256').update(body).digest('hex');
+    const message = [
+      'v2',
+      context.owner,
+      serializedIds,
+      context.capability,
+      context.scope,
+      context.longRunning ? '1' : '0',
+      timestamp,
+      digest,
+    ].join('\n');
+    const signature = createHmac('sha256', secret).update(message).digest('hex');
+    const headers = new Headers(init?.headers ?? {});
+
+    headers.set('X-Foundation-Owner', context.owner);
+    headers.set('X-Foundation-Attachments', serializedIds);
+    headers.set('X-Foundation-Capability', context.capability);
+    if (context.scope) {
+      headers.set('X-Foundation-Scope', context.scope);
+    } else {
+      headers.delete('X-Foundation-Scope');
+    }
+    if (context.longRunning) {
+      headers.set('X-Foundation-Long-Running', '1');
+    } else {
+      headers.delete('X-Foundation-Long-Running');
+    }
+    headers.set('X-Foundation-Attachment-Timestamp', timestamp);
+    headers.set('X-Foundation-Attachment-Signature', signature);
+
+    return next(url, { ...init, headers });
+  };
+}
